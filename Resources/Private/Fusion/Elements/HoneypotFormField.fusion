prototype(DL.HoneypotFormField:HoneypotField) < prototype(Neos.Form.FusionRenderer:FormElement) {
    fieldContainer {
        field {
            templatePath = 'resource://DL.HoneypotFormField/Private/Fusion/Elements/HoneypotFieldTemplate.html'
            elementName = ${elementName}
            timestampWithHmac = ${Honeypot.timestampWithHmac()}
            fieldId = ${'hp_' + element.identifier}
        }
    }
}
